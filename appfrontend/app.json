{
  "expo": {
    "name": "appfrontend",
    "slug": "appfrontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "appfrontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AASHA needs your location to include it in the SOS packet so rescue teams can find you.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "AASHA needs your location in the background so it can keep broadcasting your SOS even when the screen is off.",
        "NSBluetoothAlwaysUsageDescription": "AASHA uses Bluetooth to relay SOS packets phone-to-phone when there is no internet.",
        "NSBluetoothPeripheralUsageDescription": "AASHA uses Bluetooth to broadcast SOS packets to nearby phones."
      },
      "usesAppleSignIn": false,
      "bundleIdentifier": "com.aasha.appfrontend"
    },
    "android": {
      "package": "com.aasha.appfrontend",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AASHA needs your location to include it in your SOS packet so rescue teams can find you.",
          "locationWhenInUsePermission": "AASHA needs your location to include it in your SOS packet so rescue teams can find you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-ble-kit",
        {
          "bluetoothAlwaysPermission": "AASHA uses Bluetooth to relay SOS packets phone-to-phone when there is no internet.",
          "ios": {
            "backgroundModes": [
              "central",
              "peripheral"
            ]
          },
          "android": {
            "advertise": true,
            "foregroundService": true,
            "backgroundLocation": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
